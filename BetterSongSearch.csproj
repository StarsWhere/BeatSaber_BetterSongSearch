<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>12</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>BetterSongSearch</AssemblyName>
    <RootNamespace>BetterSongSearch</RootNamespace>
    <Version>0.8.2</Version>
    <InformationalVersion>0.8.2+bs1.45.2.download1</InformationalVersion>
    <EnableFrameworkPathOverride>true</EnableFrameworkPathOverride>
    <FrameworkPathOverride>$(GameRoot)/Beat Saber_Data/Managed</FrameworkPathOverride>
    <OutputPath>$(MSBuildProjectDirectory)/.tmp/out/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <NoWarn>$(NoWarn);CS0649;CS0414;CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="vendor\BeatSage\scripts\shared_song_import\SongPackageIO.csproj" Condition="'$(SongPackageIOPath)' == ''"
                      AdditionalProperties="RepoRoot=$(MSBuildProjectDirectory);BaseIntermediateOutputPath=$(MSBuildProjectDirectory)/.tmp/shared-obj/;OutputPath=$(MSBuildProjectDirectory)/.tmp/shared/">
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <Reference Include="SongPackageIO" Condition="'$(SongPackageIOPath)' != ''">
      <HintPath>$(SongPackageIOPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" PrivateAssets="all" />
    <Reference Include="$(GameRoot)/Beat Saber_Data/Managed/Main.dll;$(GameRoot)/Beat Saber_Data/Managed/DataModels.dll;$(GameRoot)/Beat Saber_Data/Managed/BeatmapCore.dll;$(GameRoot)/Beat Saber_Data/Managed/BeatSaber.ViewSystem.dll;$(GameRoot)/Beat Saber_Data/Managed/BGLib.AppFlow.dll;$(GameRoot)/Beat Saber_Data/Managed/BGLib.UnityExtension.dll;$(GameRoot)/Beat Saber_Data/Managed/IPA.Loader.dll;$(GameRoot)/Beat Saber_Data/Managed/SegmentedControl.dll;$(GameRoot)/Beat Saber_Data/Managed/Zenject.dll;$(GameRoot)/Beat Saber_Data/Managed/VRUI.dll;$(GameRoot)/Beat Saber_Data/Managed/VRUI.Interfaces.dll;$(GameRoot)/Beat Saber_Data/Managed/UnityEngine.CoreModule.dll;$(GameRoot)/Beat Saber_Data/Managed/UnityEngine.UI.dll;$(GameRoot)/Beat Saber_Data/Managed/UnityEngine.AudioModule.dll;$(GameRoot)/Beat Saber_Data/Managed/UnityEngine.TextRenderingModule.dll;$(GameRoot)/Beat Saber_Data/Managed/UnityEngine.ImageConversionModule.dll;$(GameRoot)/Beat Saber_Data/Managed/UnityEngine.UnityWebRequestModule.dll;$(GameRoot)/Beat Saber_Data/Managed/UnityEngine.UnityWebRequestAudioModule.dll;$(GameRoot)/Beat Saber_Data/Managed/UnityEngine.UnityWebRequestTextureModule.dll;$(GameRoot)/Beat Saber_Data/Managed/Unity.TextMeshPro.dll;$(GameRoot)/Beat Saber_Data/Managed/netstandard.dll">
      <Private>false</Private>
      <Publicize Condition="'%(Filename)' == 'Main' Or '%(Filename)' == 'BeatSaber.ViewSystem'">true</Publicize>
    </Reference>
    <Reference Include="$(GameRoot)/Beat Saber_Data/Managed/HMUI.dll"><Private>false</Private><Publicize>true</Publicize></Reference>
    <Reference Include="$(GameRoot)/Beat Saber_Data/Managed/HMLib.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameRoot)/Beat Saber_Data/Managed/UnityEngine.TextCoreFontEngineModule.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameRoot)/Libs/protobuf-net.dll;$(GameRoot)/Libs/System.IO.Compression.dll;$(GameRoot)/Libs/System.IO.Compression.FileSystem.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameRoot)/Libs/0Harmony.dll;$(GameRoot)/Libs/Newtonsoft.Json.dll;$(GameRoot)/Libs/SongDetailsCache.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameRoot)/Plugins/BSML.dll;$(GameRoot)/Plugins/SongCore.dll"><Private>false</Private></Reference>
    <EmbeddedResource Include="UI/**/*.bsml"><LogicalName>$([System.String]::Copy('BetterSongSearch.UI.%(RecursiveDir)%(Filename)%(Extension)').Replace('\','.').Replace('/','.'))</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="manifest.json"><LogicalName>BetterSongSearch.manifest.json</LogicalName></EmbeddedResource>
    <Compile Remove="Tests/**;vendor/**;.tmp/**" />
    <EmbeddedResource Remove="vendor/**;.tmp/**" />
    <None Remove="vendor/**;.tmp/**" />
  </ItemGroup>
</Project>
