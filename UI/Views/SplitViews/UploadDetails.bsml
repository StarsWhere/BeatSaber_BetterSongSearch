<modal show-event='ShowModal' hide-event='CloseModal' size-delta-x='95' size-delta-y='72'>
  <vertical pad='4' spacing='2' child-expand-height='false'>
    <text id='songName' font-size='3.2' preferred-height='9' word-wrapping='true' rich-text='false' overflow-mode='Ellipsis'/>
    <loading id='songDetailsLoading' preferred-height='5' preserve-aspect='true'/>
    <scroll-view id='descriptionScroll' preferred-width='87' preferred-height='35'>
      <vertical pad-left='4' pad-right='2' horizontal-fit='Unconstrained' vertical-fit='PreferredSize' child-control-height='true' child-expand-height='false' child-expand-width='false'>
        <text id='selectedSongDescription' preferred-width='75' min-width='75' font-size='2.6' word-wrapping='true' rich-text='false' align='TopLeft' horizontal-fit='Unconstrained' vertical-fit='PreferredSize'/>
      </vertical>
    </scroll-view>
    <horizontal spacing='2' preferred-height='7'><button text='Retry' on-click='RetryDescription' font-size='2.6'/><button text='Close' click-event='CloseModal' font-size='2.6'/></horizontal>
  </vertical>
</modal>
