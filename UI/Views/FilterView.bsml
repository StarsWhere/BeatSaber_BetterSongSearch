<vertical preferred-width='116' pad='3' spacing='2' child-expand-height='false' bg='round-rect-panel' bg-color='#101B2AE8'>
  <horizontal preferred-height='7' spacing='2'>
    <text text='Filters' font-size='3.2' preferred-width='42' align='MidlineLeft' color='#EAF2F8'/>
    <button text='Presets' on-click='ShowPresets' font-size='2.6' preferred-width='28'/>
    <button text='Reset' on-click='ClearFilters' font-size='2.6' preferred-width='22'/>
  </horizontal>
  <text id='datasetInfoLabel' text='Loading dataset...' font-size='2.4' color='#AAB8C3'/>
  <scroll-view preferred-height='78'>
    <vertical spacing='1' pad-right='2' child-control-height='true' child-expand-height='false' horizontal-fit='Unconstrained' vertical-fit='PreferredSize'>
      <vertical id='commonFilters' bg='round-rect-panel' bg-color='#203246C8' pad='3' preferred-height='24' spacing='2' horizontal-fit='Unconstrained'>
      <macro.as-host host='currentFilter'>
        <horizontal preferred-height='8' spacing='2'>
          <dropdown-list-setting id='downloadedFilter' text='Downloaded' value='existingSongs' choices='downloadedFilterOptions' bind-value='true' apply-on-change='true' on-change='UpdateData'/>
          <dropdown-list-setting id='scoreFilter' text='Local score' value='existingScore' choices='scoreFilterOptions' bind-value='true' apply-on-change='true' on-change='UpdateData'/>
        </horizontal>
        <horizontal preferred-height='8' spacing='2'>
          <dropdown-list-setting id='modeFilter' text='Mode' value='characteristic' choices='characteristics' bind-value='true' apply-on-change='true' on-change='UpdateData'/>
          <dropdown-list-setting id='difficultyFilter' text='Difficulty' value='difficulty' choices='difficulties' bind-value='true' apply-on-change='true' on-change='UpdateData'/>
        </horizontal>
      </macro.as-host>
      </vertical>
      <vertical id='advancedFilters' preferred-height='28' spacing='2' horizontal-fit='Unconstrained' child-expand-height='false'>
        <horizontal preferred-height='8' spacing='2'>
          <button text='~starsLabel' on-click='ToggleStars' font-size='2.6' preferred-width='48' preferred-height='8'/>
          <button text='~mappingLabel' on-click='ToggleMapping' font-size='2.6' preferred-width='48' preferred-height='8'/>
        </horizontal>
        <horizontal preferred-height='8' spacing='2'>
          <button text='~ratingLabel' on-click='ToggleRating' font-size='2.6' preferred-width='48' preferred-height='8'/>
          <button text='~uploaderLabel' on-click='ToggleUploaders' font-size='2.6' preferred-width='48' preferred-height='8'/>
        </horizontal>
        <horizontal preferred-height='8' spacing='2'>
          <button text='~genreLabel' on-click='ToggleGenre' font-size='2.6' preferred-width='48' preferred-height='8'/>
          <button text='~modsLabel' on-click='ToggleMods' font-size='2.6' preferred-width='48' preferred-height='8'/>
        </horizontal>
      </vertical>
      <vertical id='starsGroup' active='false' bg='round-rect-panel' bg-color='#111A24D8' pad='2' pad-left='5' pad-right='1' horizontal-fit='Unconstrained' vertical-fit='PreferredSize' child-control-height='true'>
        <macro.as-host host='currentFilter'>
          <dropdown-list-setting text='Ranked Status' value='rankedState' choices='rankedFilterOptions' bind-value='true' apply-on-change='true' on-change='UpdateData'/>
          <slider-setting text='Minimum Stars' value='minimumStars' min='0' max='15' increment='0.2' formatter='FormatShortFloat' bind-value='true' apply-on-change='true' on-change='UpdateData'/>
          <slider-setting text='Maximum Stars' value='maximumStars' min='0' max='15' increment='0.2' formatter='FormatMaxStarsFloat' bind-value='true' apply-on-change='true' on-change='UpdateData'/>
        </macro.as-host>
      </vertical>
<vertical id='mappingGroup' active='false' bg='round-rect-panel' bg-color='#111A24D8' pad='2' pad-left='5' pad-right='1' horizontal-fit='Unconstrained' vertical-fit='PreferredSize' child-control-height='true'>
        <macro.as-host host='currentFilter'>
          <slider-setting text='Minimum Length' value='minimumSongLength' max='15' increment='0.25' formatter='FormatSongLengthLimitFloat' bind-value='true' apply-on-change='true' on-change='UpdateData'/>
          <slider-setting text='Maximum Length' value='maximumSongLength' max='15' increment='0.25' formatter='FormatSongLengthLimitFloat' bind-value='true' apply-on-change='true' on-change='UpdateData'/>
          <slider-setting text='Minimum NPS' value='minimumNps' max='12' increment='0.5' formatter='FormatShortFloat' bind-value='true' apply-on-change='true' on-change='UpdateData'/>
          <slider-setting text='Maximum NPS' value='maximumNps' max='12' increment='0.5' formatter='FormatMaxNps' bind-value='true' apply-on-change='true' on-change='UpdateData'/>
          <slider-setting text='Minimum NJS' value='minimumNjs' max='25' increment='0.5' formatter='FormatShortFloat' bind-value='true' apply-on-change='true' on-change='UpdateData'/>
          <slider-setting text='Maximum NJS' value='maximumNjs' max='25' increment='0.5' formatter='FormatMaxNjs' bind-value='true' apply-on-change='true' on-change='UpdateData'/>
        </macro.as-host>
      </vertical>
<vertical id='ratingGroup' active='false' bg='round-rect-panel' bg-color='#111A24D8' pad='2' pad-left='5' pad-right='1' horizontal-fit='Unconstrained' vertical-fit='PreferredSize' child-control-height='true'>
        <macro.as-host host='currentFilter'>
          <slider-setting text='Minimum Rating' value='minimumRating' max='1' increment='0.05' formatter='PercentFloat' bind-value='true' apply-on-change='true' on-change='UpdateData'/>
          <slider-setting text='Minimum Votes' value='minimumVotes' max='100' integer-only='true' bind-value='true' apply-on-change='true' on-change='UpdateData'/>
          <slider-setting text='Min upload date' id='hideOlderThanSlider' value='_hideOlderThan' min='0' max='2' integer-only='true' formatter='DateTimeToStr' bind-value='true' apply-on-change='true' on-change='UpdateData'/>
          <toggle-setting text='Curated Maps' value='onlyCuratedMaps' apply-on-change='true' on-change='UpdateData'/>
          <toggle-setting text='Verified Mappers' value='onlyVerifiedMappers' apply-on-change='true' on-change='UpdateData'/>
        </macro.as-host>
      </vertical>
<vertical id='uploaderGroup' active='false' bg='round-rect-panel' bg-color='#111A24D8' pad='2' pad-left='5' pad-right='1' horizontal-fit='Unconstrained' vertical-fit='PreferredSize' child-control-height='true'>
        <macro.as-host host='currentFilter'><string-setting text='Uploader(s)' value='uploadersString' bind-value='true' apply-on-change='true' formatter='FormatUploaderShortInfo' on-change='UpdateData'/></macro.as-host>
      </vertical>
<vertical id='genreGroup' active='false' bg='round-rect-panel' bg-color='#111A24D8' pad='2' pad-left='5' pad-right='1' horizontal-fit='Unconstrained' vertical-fit='PreferredSize' child-control-height='true'>
        <macro.as-host host='currentFilter'>
          <dropdown-list-setting text='Map Style' value='mapStyleString' choices='mapStyles' formatter='FormatBeatSaverTag' bind-value='true' apply-on-change='true' on-change='UpdateData'/>
          <button id='genrePickButton' text='Song Genre' on-click='ShowGenrePicker' font-size='2.6'/>
        </macro.as-host>
      </vertical>
<vertical id='modsGroup' active='false' bg='round-rect-panel' bg-color='#111A24D8' pad='2' pad-left='5' pad-right='1' horizontal-fit='Unconstrained' vertical-fit='PreferredSize' child-control-height='true'>
        <macro.as-host host='currentFilter'><dropdown-list-setting text='Requirement' value='mods' choices='modOptions' bind-value='true' apply-on-change='true' on-change='UpdateData'/></macro.as-host>
      </vertical>
    </vertical>
  </scroll-view>
</vertical>
