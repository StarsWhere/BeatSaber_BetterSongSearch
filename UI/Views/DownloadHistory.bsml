<vertical child-control-height="true" horizontal-fit="Unconstrained" preferred-width="120" xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xsi:schemaLocation='- https://raw.githubusercontent.com/monkeymanboy/BSML-Docs/gh-pages/BSMLSchema.xsd'>
	<horizontal preferred-width='120' preferred-height='6' horizontal-fit='Unconstrained' pad-bottom='1'>
		<button id='retryButton' text='Retry' active='false' on-click='RetryDownload' preferred-width='12'/>
	</horizontal>
	<horizontal preferred-width='120' preferred-height='62' horizontal-fit='Unconstrained' child-control-height='true'>
		<vertical preferred-width='104' horizontal-fit='Unconstrained'>
			<list id='downloadList' select-cell='SelectSong' visible-cells='5'/>
		</vertical>
		<vertical preferred-width='8' id='scrollBarContainer' vertical-fit='Unconstrained'/>
	</horizontal>
</vertical>
