<vertical preferred-width='120' pad='2' spacing='1' child-expand-height='false'>
  <vertical id='searchBoxContainer' preferred-width='114' min-width='114' preferred-height='6' horizontal-fit='Unconstrained' vertical-fit='Unconstrained'/>
  <horizontal preferred-height='8' spacing='2'>
    <text id='resultCount' text='Loading dataset...' font-size='2.4' preferred-width='22' align='MidlineLeft' color='#AAB8C3'/>
    <dropdown-list-setting id='sortDropdown' min-width='65' preferred-width='65' text='Sort' value='selectedSortMode' choices='sortModeSelections' apply-on-change='true' on-change='UpdateDataAndFilters'/>
    <button text='Tools' event-click='ShowMoreModal' preferred-width='17' font-size='2.6'/>
    <loading id='searchInProgress' active='false' preferred-width='5' preserve-aspect='true'/>
  </horizontal>
  <horizontal preferred-height='75' spacing='1'>
    <vertical preferred-width='106'><list id='songList' select-cell='SelectSong' visible-cells='6'/></vertical>
    <vertical id='scrollBarContainer' preferred-width='7' vertical-fit='Unconstrained'/>
  </horizontal>
  <modal show-event='ShowMoreModal' hide-event='HideMoreModal' size-delta-x='65' size-delta-y='46'>
    <vertical pad='3' spacing='1'>
      <button text='Random' on-click='SelectRandom' click-event='HideMoreModal' font-size='2.6'/>
      <button text='Batch Download' on-click='ShowMultiDlModal' click-event='HideMoreModal' font-size='2.6'/>
      <button text='Create / Update Playlist' on-click='ShowPlaylistCreation' click-event='HideMoreModal' font-size='2.6'/>
      <button text='Settings' on-click='ShowSettings' click-event='HideMoreModal' font-size='2.6'/>
    </vertical>
  </modal>
</vertical>
