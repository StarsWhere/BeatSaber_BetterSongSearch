<horizontal id='bgContainer' bg='round-rect-panel' bg-color='#111A24D8' preferred-height='12.5' horizontal-fit='Unconstrained' vertical-fit='Unconstrained' pad='0' spacing='2' child-expand-height='false'>
  <image id='cover' preferred-width='9' preferred-height='9' preserve-aspect='true'/>
  <vertical preferred-width='93' min-width='93' horizontal-fit='Unconstrained' vertical-fit='Unconstrained' spacing='0' child-expand-height='false'>
    <horizontal preferred-height='4.5' spacing='2'>
      <text horizontal-fit='Unconstrained' vertical-fit='Unconstrained' id='songName' font-size='3.2' bold='true' align='MidlineLeft' overflow-mode='Ellipsis' word-wrapping='false' rich-text='false'/>
      <text horizontal-fit='Unconstrained' vertical-fit='Unconstrained' id='songState' font-size='2.4' preferred-width='18' align='MidlineRight' overflow-mode='Ellipsis' word-wrapping='false' rich-text='false' color='#8FD4E8'/>
    </horizontal>
    <horizontal preferred-height='3.5' spacing='2'>
      <text horizontal-fit='Unconstrained' vertical-fit='Unconstrained' id='songAuthorName' font-size='2.4' align='MidlineLeft' overflow-mode='Ellipsis' word-wrapping='false' rich-text='false' color='#AAB8C3'/>
      <text horizontal-fit='Unconstrained' vertical-fit='Unconstrained' id='songStats' font-size='2.4' preferred-width='20' align='MidlineRight' word-wrapping='false' rich-text='false' color='#CCD6DF'/>
    </horizontal>
    <text horizontal-fit='Unconstrained' vertical-fit='Unconstrained' id='songSummary' font-size='2.4' preferred-height='3.5' align='MidlineLeft' overflow-mode='Ellipsis' word-wrapping='false' rich-text='true' color='#CCD6DF'/>
  </vertical>
</horizontal>
